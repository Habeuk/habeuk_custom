{#
 /**
  * Ce template est fortement relier à habeuk car on a besoin de mettre en place la partie vente rapidement, moins de 24h. en ce qui concerne les sites webs.
  */
#}
<!--   -->
<div class="modal fade hbktabs-order-site-modal" id="{{-id_tabs-}}-modal" tabindex="-1"
	aria-labelledby="{{-id_tabs-}}-modalLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content bg-transparent border-0">
			<div {{ attributes.addClass(['hbktabs-order-site']) }}>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				<ul class="nav nav-pills" id="{{-id_tabs-}}" role="tablist">
					{% for key, tab in tabs %}
					<li class="nav-item fw-normal h3 mb-0" role="presentation">
						<button class="nav-link {% if tab.status_tab %}active{% endif %}"
							id="{{-tab.id_tab-}}-tab" data-bs-toggle="tab" data-bs-target="#
							{{-tab.id_tab-}}-tab-pane" type="button" role="tab"
							aria-controls="{{-tab.id_tab-}}-tab-pane"
							aria-selected="{% if tab.status_tab %}true{% else %}false{% endif %}">{{ tab.icone|raw }}<span class="texte">{{ tab.titre }}</span></button>
					</li>
					{% endfor %}
				</ul>
				<div class="tab-content">
					{% for key, tab in tabs %}
					<div class="tab-pane fade {% if tab.status_tab %}show active{% endif %}" id="{{-tab.id_tab-}}-tab-pane" role="tabpanel"
						aria-labelledby="{{-tab.id_tab-}}-tab" tabindex="0">
						{{ tab.entity_form }}
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#{{-id_tabs-}}-modal">modal order</button>
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">Launch demo modal</button>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1"
	aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal"
					aria-label="Close"></button>
			</div>
			<div class="modal-body">...</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary"
					data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary">Save changes</button>
			</div>
		</div>
	</div>
</div>