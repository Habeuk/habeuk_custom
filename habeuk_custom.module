<?php

/**
 *
 * @file
 * Primary module hooks for Habeuk custom module.
 */
/**
 * Implements hook_theme().
 */
function habeuk_custom_theme() {
  $hooks = [];
  $hooks['hbktabs_order_site'] = [
    'variables' => [
      'tabs' => [],
      'id_tabs' => NULL
    ]
  ];
  return $hooks;
}

/**
 * Implements hook_page_attachments().
 */
function habeuk_custom_page_attachments(array &$attachments) {
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => [
        'property' => 'og:logo',
        'content' => 'https://habeuk.com/sites/default/files/styles/medium/public/2024-11/hlogo.png'
      ]
    ],
    'og_logo'
  ];
}

